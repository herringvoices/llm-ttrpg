{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LLM TTRPG",
  "version": "0.1.1",
  "identifier": "com.herringvoices.llm-ttrpg",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": { "csp": null },
    "windows": [
      {
        "title": "LLM TTRPG",
        "width": 960,
        "height": 720,
        "minWidth": 640,
        "minHeight": 480
      }
    ]
  },
  "plugins": {
    "sql": { "preload": ["sqlite:llm-ttrpg.db"] }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "RolePlayingGame",
    "shortDescription": "A local, persistent, text-first RPG",
    "longDescription": "A local, single-player RPG where an embedded language model interprets natural-language actions and an authoritative simulation owns world truth.",
    "resources": ["resources/llama/*", "resources/THIRD_PARTY_NOTICES.md"],
    "windows": {
      "nsis": { "installMode": "currentUser" }
    }
  }
}
